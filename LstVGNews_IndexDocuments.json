      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0],
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Upload Document Form",
      "webhookId": "lst-index-form-0001"
    },
    {
      "parameters": {
        "operation": "text",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [224, 0],
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Extract Text from File"
    },
    {
      "parameters": {
        "jsCode": "// Chunka dokumenttexten i block om ~500 ord.\n// Använder det namn användaren angav i formuläret som source-etikett.\nconst text = $json.text || '';\nconst source = $('Upload Document Form').first().json['Dokumentnamn (visas i nyhetsmailen)'] || 'Okänt dokument';\n\nconst CHUNK_SIZE = 500;\nconst words = text.split(/\\s+/).filter(w => w.length > 0);\nconst chunks = [];\n\nfor (let i = 0; i < words.length; i += CHUNK_SIZE) {\n  const content = words.slice(i, i + CHUNK_SIZE).join(' ');\n  if (content.trim().length > 50) {\n    chunks.push({ source, content, chunkIndex: chunks.length });\n  }\n}\n\nreturn chunks.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Chunk Text"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.berget.ai/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"text-embedding-3-small\",\n  \"input\": {{ JSON.stringify($json.content) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [672, 0],
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Embed Chunk",
      "credentials": {
        "httpHeaderAuth": {
          "id": "W50gIWCCSWBnYxEG",
          "name": "Berget AI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const embedding = $json.data[0].embedding;\nconst source = $('Chunk Text').item.json.source;\nconst content = $('Chunk Text').item.json.content;\n\nreturn [{ json: { embedding, source, content } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0],
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Merge Embedding + Chunk"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS document_chunks (\n  id SERIAL PRIMARY KEY,\n  source TEXT NOT NULL,\n  content TEXT NOT NULL,\n  embedding VECTOR(1536),\n  indexed_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nCREATE INDEX IF NOT EXISTS document_chunks_embedding_idx\n  ON document_chunks USING ivfflat (embedding vector_cosine_ops);\n\nINSERT INTO document_chunks (source, content, embedding)\nVALUES ($1, $2, $3::vector);",
        "options": {
          "queryParams": "={{ [$json.source, $json.content, JSON.stringify($json.embedding)] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1120, 0],
