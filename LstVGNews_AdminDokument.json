    {
      "parameters": {
        "jsCode": "const docs = $json.data || [];\nconst now = new Date().toLocaleString('sv-SE');\n\nconst C = {\n  primary: '#004B87',\n  gold: '#E4B363',\n  bg: '#EAEEF2',\n  white: '#FFFFFF',\n  border: '#E0E0E0',\n  headerCell: '#003D72',\n  text: '#1a1a1a',\n  rowAlt: '#F0F4F8',\n};\n\nconst rows = docs.length === 0\n  ? `<tr><td colspan=\"3\" style=\"padding:20px;text-align:center;font-family:Arial,sans-serif;font-size:14px;color:#999;font-style:italic;\">Inga dokument indexerade ännu.</td></tr>`\n  : docs.map((d, i) => `\n    <tr style=\"background-color:${i % 2 === 0 ? C.white : C.rowAlt};\">\n      <td style=\"padding:12px 16px;font-family:Arial,sans-serif;font-size:14px;color:${C.text};border-bottom:1px solid ${C.border};\">${d.dokument}</td>\n      <td style=\"padding:12px 16px;font-family:Arial,sans-serif;font-size:14px;color:${C.text};border-bottom:1px solid ${C.border};text-align:center;\">${d.antal_chunks}</td>\n      <td style=\"padding:12px 16px;font-family:Arial,sans-serif;font-size:14px;color:${C.text};border-bottom:1px solid ${C.border};\">${d.indexerad}</td>\n    </tr>`).join('');\n\nconst deleteFormUrl = '[URL till LstVGNews_DeleteDocument-flödet]';\n\nconst html = `<!DOCTYPE html>\n<html lang=\"sv\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>LstVGNews — Indexerade dokument</title></head>\n<body style=\"margin:0;padding:24px;background-color:${C.bg};font-family:Arial,Helvetica,sans-serif;\">\n  <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:700px;width:100%;margin:0 auto;background-color:${C.white};\">\n    <tr><td style=\"background-color:${C.primary};padding:0;\">\n      <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n        <tr><td style=\"height:4px;background-color:${C.gold};font-size:1px;\"></td></tr>\n      </table>\n      <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n        <tr><td style=\"padding:24px 32px 6px 32px;\"><span style=\"font-family:Georgia,serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:${C.gold};\">Länsstyrelsen Västra Götaland</span></td></tr>\n        <tr><td style=\"padding:0 32px 20px 32px;\"><span style=\"font-family:Georgia,serif;font-size:22px;font-weight:bold;color:#fff;\">LstVGNews</span><span style=\"font-family:Georgia,serif;font-size:22px;color:rgba(255,255,255,0.45);\"> — </span><span style=\"font-family:Georgia,serif;font-size:22px;font-style:italic;color:rgba(255,255,255,0.8);\">Indexerade dokument</span></td></tr>\n      </table>\n    </td></tr>\n    <tr><td style=\"padding:28px 32px 8px 32px;\">\n      <p style=\"font-family:Arial,sans-serif;font-size:13px;color:#777;margin:0 0 20px 0;\">Hämtad: ${now} &nbsp;·&nbsp; ${docs.length} dokument indexerade</p>\n      <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n        <thead>\n          <tr>\n            <th style=\"background-color:${C.headerCell};color:#fff;font-family:Arial,sans-serif;font-size:11px;letter-spacing:1px;text-transform:uppercase;padding:10px 16px;text-align:left;\">Dokument</th>\n            <th style=\"background-color:${C.headerCell};color:#fff;font-family:Arial,sans-serif;font-size:11px;letter-spacing:1px;text-transform:uppercase;padding:10px 16px;text-align:center;\">Chunks</th>\n            <th style=\"background-color:${C.headerCell};color:#fff;font-family:Arial,sans-serif;font-size:11px;letter-spacing:1px;text-transform:uppercase;padding:10px 16px;text-align:left;\">Indexerad</th>\n          </tr>\n        </thead>\n        <tbody>${rows}</tbody>\n      </table>\n    </td></tr>\n    <tr><td style=\"padding:20px 32px 28px 32px;\">\n      <p style=\"font-family:Arial,sans-serif;font-size:13px;color:#555;margin:0 0 8px 0;\">Vill du ta bort ett dokument från indexet? Kör SQL:</p>\n      <code style=\"display:block;background:#F0F4F8;padding:12px 16px;font-size:12px;color:#003D72;border-left:3px solid ${C.gold};\">DELETE FROM document_chunks WHERE source = 'Dokumentnamn';</code>\n    </td></tr>\n    <tr><td style=\"background-color:${C.primary};padding:0;\">\n      <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n        <tr><td style=\"height:3px;background-color:${C.gold};font-size:1px;\"></td></tr>\n      </table>\n      <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n        <tr><td style=\"padding:14px 32px;\"><p style=\"font-family:Arial,sans-serif;font-size:11px;color:rgba(255,255,255,0.5);margin:0;\">LstVGNews Admin · ${now}</p></td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body></html>`;\n\nreturn [{ json: { html } }];"
      },
